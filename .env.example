APIFY_API_KEY=your_apify_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=4000
# Strong shared team password (required in production; >=8 chars, not a common value).
AUTH_PASSWORD=your_team_password_here
# Long random string (required in production; >=16 chars). Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-random-string-here
# PostgreSQL enables durable production sessions; Railway supplies this automatically.
DATABASE_URL=
# Optional comma-separated extra browser origins. Same-origin production is allowed automatically.
CORS_ORIGINS=
# Optional error monitoring. REACT_APP_SENTRY_DSN must be present while building the client.
SENTRY_DSN=
REACT_APP_SENTRY_DSN=
# Film service and signed media (shared service key with HQ).
FILM_SERVICE_KEY=
FILM_MEDIA_SECRET=
PUBLIC_BASE_URL=
# React render downloads and callbacks must stay on this HTTPS origin.
HQ_PUBLIC_URL=
# Defaults to a sibling react-refs directory beside the video cache; keep on persistent storage.
REACT_REF_DIR=
# On-demand Instagram reference fetches (rolling 24-hour launch cap).
# React-only Apify token; falls back to APIFY_API_KEY when empty.
# This key does not enable scheduled scraping, discovery, or radar.
REACT_APIFY_API_KEY=
# Failed fetches retry after 10 minutes for transient errors, otherwise 6 hours.
REACT_FETCH_DAILY_MAX=100
REACT_FETCH_CONCURRENCY=1
REACT_FETCH_MEMORY_MB=512
REACT_FETCH_TIMEOUT_SEC=180
REACT_RENDER_CONCURRENCY=1
REACT_RENDER_TIMEOUT_SEC=900
# Per-render encoder/filter threads: positive integer, capped at 16; invalid values use 2.
REACT_FFMPEG_THREADS=2
# Best-effort ffmpeg/ffprobe CPU nice level (0 disables; integers 1..19; invalid values use 10).
REACT_FFMPEG_NICE=10
REACT_RAW_MAX_MB=1024
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
